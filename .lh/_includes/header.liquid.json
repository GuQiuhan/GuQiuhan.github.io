            "date": 1763494799924,
            "name": "Commit-0",
            "content": "<header>\n  <!-- Nav Bar -->\n  <nav id=\"navbar\" class=\"navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}\" role=\"navigation\">\n    <div class=\"container\">\n      {% if page.permalink != '/' %}\n        <a class=\"navbar-brand title font-weight-lighter\" href=\"{{ site.baseurl }}/\">\n          {% if site.title == 'blank' %}\n            {% if site.first_name %}\n              <span class=\"font-weight-bold\">\n                {{- site.first_name -}}\n              </span>\n            {% endif %}\n            {% if site.middle_name %}\n              {{- site.middle_name -}}\n            {% endif %}\n            {% if site.last_name %}\n              {{- site.last_name -}}\n            {% endif %}\n          {% else %}\n            {{- site.title -}}\n          {% endif %}\n        </a>\n      {% elsif site.enable_navbar_social %}\n        <!-- Social Icons -->\n        <div class=\"navbar-brand social\">{% include social.liquid %}</div>\n      {% endif %}\n      <!-- Navbar Toggle -->\n      <button\n        class=\"navbar-toggler collapsed ml-auto\"\n        type=\"button\"\n        data-toggle=\"collapse\"\n        data-target=\"#navbarNav\"\n        aria-controls=\"navbarNav\"\n        aria-expanded=\"false\"\n        aria-label=\"Toggle navigation\"\n      >\n        <span class=\"sr-only\">Toggle navigation</span>\n        <span class=\"icon-bar top-bar\"></span>\n        <span class=\"icon-bar middle-bar\"></span>\n        <span class=\"icon-bar bottom-bar\"></span>\n      </button>\n\n      <div class=\"collapse navbar-collapse text-right\" id=\"navbarNav\">\n        <ul class=\"navbar-nav ml-auto flex-nowrap\">\n          {% for page in site.pages %}\n            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}\n          {% endfor %}\n\n          <!-- About -->\n          <li class=\"nav-item {% if page.permalink == '/' %}active{% endif %}\">\n            <a class=\"nav-link\" href=\"{{ '/' | relative_url }}\">\n              {{- about_title }}\n              {% if page.permalink == '/' %}\n                <span class=\"sr-only\">(current)</span>\n              {% endif %}\n            </a>\n          </li>\n\n          <!-- Resume -->\n          <li class=\"nav-item {% if page.permalink == '/resume' %}active{% endif %}\">\n            <a class=\"nav-link\" href=\"{{ '/docs/resume.pdf' | relative_url }}\">{{ \"CV\" }}\n              {%- if page.permalink == '/' -%}\n                <span class=\"sr-only\">(current)</span>\n              {%- endif -%}\n            </a>\n          </li>\n\n          <!-- Other pages -->\n          {% assign sorted_pages = site.pages | sort: 'nav_order' %}\n          {% for p in sorted_pages %}\n            {% if p.nav and p.autogen == null %}\n              {% if p.dropdown %}\n                {% assign has_active_child = false %}\n                {% for child in p.children %}\n                  {% if page.title == child.title %}\n                    {% assign has_active_child = true %}\n                  {% endif %}\n                {% endfor %}\n                <li class=\"nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}\">\n                  <a\n                    class=\"nav-link dropdown-toggle\"\n                    href=\"#\"\n                    id=\"navbarDropdown\"\n                    role=\"button\"\n                    data-toggle=\"dropdown\"\n                    aria-haspopup=\"true\"\n                    aria-expanded=\"false\"\n                  >\n                    {{- p.title }}\n                    {% if page.title == p.title or has_active_child %}\n                      <span class=\"sr-only\">(current)</span>\n                    {% endif %}\n                  </a>\n                  <div class=\"dropdown-menu dropdown-menu-right\" aria-labelledby=\"navbarDropdown\">\n                    {% for child in p.children %}\n                      {% if child.title == 'divider' %}\n                        <div class=\"dropdown-divider\"></div>\n                      {% else %}\n                        <a class=\"dropdown-item {% if page.title == child.title %}active{% endif %}\" href=\"{{ child.permalink | relative_url }}\">\n                          {{- child.title -}}\n                        </a>\n                      {% endif %}\n                    {% endfor %}\n                  </div>\n                </li>\n              {% else %}\n                {% assign parent_link = p.permalink | remove: 'index.html' %}\n                <li class=\"nav-item {% if page.url contains parent_link %}active{% endif %}\">\n                  {% if p.permalink contains '/blog/' %}{% assign url = '/blog/' %} {% else %}{% assign url = p.url %}{% endif %}\n                  <a class=\"nav-link\" href=\"{{ url | relative_url }}\">\n                    {{- p.title }}\n                    {% if page.url contains p.url %}\n                      <span class=\"sr-only\">(current)</span>\n                    {% endif %}\n                  </a>\n                </li>\n              {% endif %}\n            {% endif %}\n          {% endfor %}\n          {% if site.search_enabled %}\n            <!-- Search -->\n            <li class=\"nav-item\">\n              <button id=\"search-toggle\" title=\"Search\" onclick=\"openSearchModal()\">\n                <span class=\"nav-link\">ctrl k <i class=\"ti ti-search\"></i></span>\n              </button>\n            </li>\n          {% endif %}\n          {% if site.enable_darkmode %}\n            <!-- Toogle theme mode -->\n            <li class=\"toggle-container\">\n              <button id=\"light-toggle\" title=\"Change theme\">\n                <i class=\"ti ti-sun-moon\" id=\"light-toggle-system\"></i>\n                <i class=\"ti ti-moon-filled\" id=\"light-toggle-dark\"></i>\n                <i class=\"ti ti-sun-filled\" id=\"light-toggle-light\"></i>\n              </button>\n            </li>\n          {% endif %}\n        </ul>\n      </div>\n    </div>\n  </nav>\n  {% if site.enable_progressbar %}\n    <!-- Scrolling Progress Bar -->\n    <progress id=\"progress\" value=\"0\">\n      <div class=\"progress-container\">\n        <span class=\"progress-bar\"></span>\n      </div>\n    </progress>\n  {% endif %}\n</header>\n"
        }
    ]
